<?xml version="1.0" encoding="utf-8"?>
<!--
  小財 — body only. The face is a separate drawable layered on top so the
  renderer can swap expressions without redrawing the character, and so a
  future Rive/Lottie renderer can replace either layer independently.
  Round, soft, warm; readable at 56dp on any wallpaper thanks to the rim.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- contact shadow -->
    <path
        android:pathData="M26,97 a28,6 0 1,0 56,0 a28,6 0 1,0 -56,0"
        android:fillColor="#26000000" />

    <!-- soft outer rim keeps the pet visible on white and on black -->
    <path
        android:pathData="M11,55 a43,43 0 1,0 86,0 a43,43 0 1,0 -86,0"
        android:fillColor="#33FFFFFF" />

    <!-- body -->
    <path
        android:pathData="M14,55 a40,40 0 1,0 80,0 a40,40 0 1,0 -80,0"
        android:fillColor="#FFD66B"
        android:strokeColor="#E0AE45"
        android:strokeWidth="2" />

    <!-- belly highlight -->
    <path
        android:pathData="M32,67 a22,19 0 1,0 44,0 a22,19 0 1,0 -44,0"
        android:fillColor="#FFF3D2" />

    <!-- top sprout -->
    <path
        android:pathData="M54,16 C52,8 58,4 62,7 C58,8 56,12 57,16 Z"
        android:fillColor="#8FBF7F" />

    <!-- wings -->
    <path
        android:pathData="M14,58 C8,52 10,42 18,40 C16,48 16,54 20,60 Z"
        android:fillColor="#F5C755" />
    <path
        android:pathData="M94,58 C100,52 98,42 90,40 C92,48 92,54 88,60 Z"
        android:fillColor="#F5C755" />

    <!-- coin held at the belly: the finance cue, not a bank logo -->
    <path
        android:pathData="M43,83 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0"
        android:fillColor="#F5B940"
        android:strokeColor="#D0921F"
        android:strokeWidth="1.8" />
    <path
        android:pathData="M54,77.5 L54,88.5 M50.5,80 C57.5,78.4 57.5,83.4 50.5,83.4 C57.5,83.4 57.5,88.4 50.5,86.8"
        android:strokeColor="#B57F1F"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
